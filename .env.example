# Copy to .env and fill in real values. Never commit .env.
#
# Deriv now runs two API generations in parallel (see docs/postmortem/PROJECT_POSTMORTEM.md
# item 2). A new-portal app_id (alphanumeric, from Registered Apps) + a personal
# access token (pat_..., ~68 chars) belong to the new "Options API" generation and
# require the REST -> OTP -> WebSocket handshake this project implements. They will
# NOT work against the legacy wss://ws.derivws.com in-band authorize flow.
DERIV_APP_ID=your_new_portal_app_id
DERIV_API_TOKEN=pat_your_personal_access_token
DERIV_ACCOUNT_TYPE=demo
DERIV_CURRENCY=USD

# Comma-separated, no spaces, no JSON brackets/quotes (pydantic-settings will try
# to JSON-decode a list-typed field before validation runs; keep this a plain str).
SYMBOLS=R_10,R_25,R_50,R_75,R_100
TIMEFRAME_SECONDS=60

STAKE=1.00
MAX_DAILY_LOSS=10.00
MAX_TRADES_PER_DAY=10

DATABASE_URL=sqlite:///./data/quantum_tick.db
LOG_LEVEL=INFO

# Live trading only fires when DRY_RUN=false AND DERIV_ACCOUNT_TYPE=real.
DRY_RUN=true
